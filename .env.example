# ==============================================================================
#                  OCEANEMBED ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE FOR VERCEL DEPLOYMENT:
# In Vercel Edge Deployment mode, NO ENVIRONMENT VARIABLES ARE REQUIRED!
# OceanEmbed bundles pre-computed 0.25° grid predictions, ARGO matchups, and client-side
# Mackenzie 9-term acoustics into static edge bundles (dist/) that run with zero config.
#
# If you run the Python FastAPI backend or offline data downloading, copy this file:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production Web & FastAPI Server Runtime (Render / Docker / Local Uvicorn)
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
PYTHON_VERSION=3.10.12
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Offline Satellite Data Harvesting (Optional: Only for model retraining)
# ------------------------------------------------------------------------------
# Copernicus Marine Service (CMEMS) - For OSTIA SST, DUACS SLA & GLORYS12V1 targets
COPERNICUSMARINE_SERVICE_USERNAME=your_cmems_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_cmems_password

# NASA Earthdata / PO.DAAC - For OSCAR v2.0 ocean currents
EARTHDATA_TOKEN=your_nasa_earthdata_bearer_token

# ECMWF Climate Data Store (CDS) - For ERA5 10m surface winds
CDSAPI_KEY=your_ecmwf_cds_api_key
