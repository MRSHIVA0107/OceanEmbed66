    },
    "guard_gap_1": {
      "start": "2022-12-01",
      "end": "2022-12-31",
      "days": 31,
      "role": "One-month seasonal buffer (quarantine)"
    },
    "validation_block": {
      "start": "2023-01-01",
      "end": "2023-04-30",
      "days": 120,
      "role": "Hyperparameter tuning & early stopping"
    },
    "guard_gap_2": {
      "start": "2023-05-01",
      "end": "2023-05-31",
      "days": 31,
      "role": "Pre-monsoon buffer (quarantine)"
    },
    "test_block": {
      "start": "2023-06-01",
      "end": "2023-08-31",
      "days": 92,
      "role": "Peak Southwest Monsoon holdout evaluation"
